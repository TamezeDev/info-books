<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zeki.infobooks.controller.scene.SearchViewController">
   <children>
      <ImageView fitHeight="800.0" fitWidth="1200.0" pickOnBounds="true">
         <image>
            <Image url="@../img/main_bg.png" />
         </image>
      </ImageView>
      <VBox alignment="TOP_CENTER">
         <children>
            <ImageView fitHeight="208.0" fitWidth="750.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../img/title.png" />
               </image>
               <VBox.margin>
                  <Insets top="35.0" />
               </VBox.margin>
            </ImageView>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <VBox alignment="TOP_CENTER" maxWidth="600.0" prefHeight="200.0" prefWidth="600.0">
                     <children>
                        <HBox fx:id="searchBox" alignment="CENTER">
                           <children>
                              <TextField fx:id="searcherField" alignment="CENTER" maxWidth="-Infinity" prefWidth="200.0" promptText="Id a buscar" />
