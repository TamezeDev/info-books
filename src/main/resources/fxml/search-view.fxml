                        <Button fx:id="saveBookBtn" mnemonicParsing="false" styleClass="global_bg, btn_bg, button-typeA" text="Guardar en favoritos" />
                        <Button fx:id="deleteBookBtn" disable="true" layoutX="345.0" layoutY="26.0" mnemonicParsing="false" styleClass="global_bg ,btn_bg, button-typeA" text="Eliminar de favoritos" />
                     </children>
