                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </VBox>
                                    <VBox alignment="TOP_CENTER" layoutX="237.0" layoutY="10.0" prefWidth="290.0">
                                       <children>
                                          <Label styleClass="labelTypeA" text="Villanos" />
                                          <ScrollPane prefWidth="200.0">
                                             <content>
                                                <VBox fx:id="villainsBox" alignment="TOP_CENTER" maxWidth="-Infinity" prefHeight="160.0" prefWidth="240.0" spacing="15.0">
                                                   <padding>
                                                      <Insets top="20.0" />
                                                   </padding></VBox>
                                             </content>
                                             <padding>
                                                <Insets left="10.0" />
                                             </padding>
                                          </ScrollPane>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                           <VBox.margin>
