                                 <children>
                                    <VBox alignment="CENTER" maxWidth="-Infinity" prefWidth="290.0" spacing="15.0" styleClass="separator">
                                       <children>
                                          <Label fx:id="idLabel" styleClass="labelTypeA" text="Id:" />
                                          <Label fx:id="titleLabel" styleClass="labelTypeA" text="Título:" />
                                          <Label fx:id="yearLabel" styleClass="labelTypeA" text="Año:" />
                                          <Label fx:id="pagesLabel" styleClass="labelTypeA" text="Páginas:" />
                                          <Label fx:id="publisherLabel" styleClass="labelTypeA" text="Editorial:" />
                                          <Label fx:id="isbnLabel" layoutX="108.0" layoutY="187.0" styleClass="labelTypeA" text="Isbn:" />
