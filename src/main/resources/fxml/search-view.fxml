                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="feedbackBox" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="50.0" prefWidth="500.0" styleClass="global_bg, feedBack_bg" visible="false">
